rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────
    // Bootstrap owners — kept only so the original two accounts can never be
    // locked out while the `admins/{email}` collection is being populated.
    // Prefer granting access via the `admins` collection (see AdminUsers.jsx).
    function isLegacyOwner() {
      return request.auth != null
        && (
          ('admin' in request.auth.token && request.auth.token.admin == true)
          || (request.auth.token.email_verified == true
            && request.auth.token.email in ["binashad7@gmail.com", "creatifybd@gmail.com"])
        );
    }

    function isRegisteredAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function adminRole() {
      return isRegisteredAdmin()
        ? get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role
        : (isLegacyOwner() ? 'owner' : null);
    }

    function isAdmin() {
      return isLegacyOwner() || isRegisteredAdmin();
    }

    function isOwner() {
      return isAdmin() && adminRole() == 'owner';
    }

    function isEditorOrAbove() {
      return isAdmin() && adminRole() in ['owner', 'editor'];
    }

    // ─── RBAC: Admin Users Directory ─────────────────────────────────────────
    // Doc ID is the admin's lowercase email. Only owners can manage this list;
    // any admin may read it to know who else has access.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    function boundedOptional(data, key, maximum) {
      return !(key in data) || (data[key] is string && data[key].size() <= maximum);
    }

    function isValidMessage() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'email', 'phone', 'company', 'service', 'budget', 'timeline', 'message', 'createdAt', 'updatedAt', 'status', 'read'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.email is string && data.email.size() <= 180
        && (data.email.size() == 0 || data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$'))
        && data.phone is string && data.phone.matches('^([+]?88)?01[3-9][0-9]{8}$')
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 3000
        && boundedOptional(data, 'company', 150) && boundedOptional(data, 'service', 100)
        && boundedOptional(data, 'budget', 100) && boundedOptional(data, 'timeline', 120)
        && data.createdAt == request.time && data.updatedAt == request.time
        && data.status == 'unread' && data.read == false;
    }

    // ─── Contact Messages ────────────────────────────────────────────────────
    match /messages/{message} {
      allow create: if isValidMessage();
      allow read: if isAdmin();
      allow update, delete: if isEditorOrAbove();
      match /notes/{noteId} {
        allow read: if isAdmin();
        allow create: if isEditorOrAbove()
          && request.resource.data.keys().hasOnly(['text', 'createdAt', 'createdBy'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Newsletter signup is inactive. Retain existing addresses privately.
    match /subscribers/{id} {
      allow create: if isEditorOrAbove();
      allow read: if isAdmin();
      allow update, delete: if isEditorOrAbove();
    }
    match /lead_crm/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    // Immutable releases and migration backups are only written by Admin SDK.
    match /site_releases/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /content_release_backups/{releaseId}/documents/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ─── Existing CMS Collections ────────────────────────────────────────────
    // Note: write access requires Editor or Owner role — Viewers are read-only
    // even via direct API calls (see AdminUsers.jsx role descriptions).
    match /services/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    match /portfolio/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    match /team_members/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    match /testimonials/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    match /pricing/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    // ─── Settings Collection (Split for Security) ────────────────────────────────
    // Public settings (safe for public read)
    match /settings/public/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    // Private settings (admin only - payment info, sensitive data)
    match /settings/private/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    // Legacy settings (for backward compatibility)
    match /settings/{id} {
      // Public copy comes from the allowlisted release snapshot. Draft settings
      // can retain legacy/private fields and must not be exposed by this API.
      allow read: if id == 'publishing' || isAdmin();
      allow write: if isEditorOrAbove() && id != 'publishing';
    }
    match /case_study_images/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    match /case_studies/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    match /gig_overrides/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }
    match /media_assets/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }

    // ─── Manual Payments (legacy) ────────────────────────────────────────────
    function isValidPayment() {
      return request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.phone is string
        && request.resource.data.selectedService is string
        && request.resource.data.paymentMethod is string
        && (request.resource.data.paidAmount is string || request.resource.data.paidAmount is number)
        && request.resource.data.transactionId is string
        && request.resource.data.proofFileUrl is string
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp;
    }

    match /manualPayments/{paymentId} {
      allow create: if isEditorOrAbove() && isValidPayment();
      allow read: if isAdmin();
      allow update: if isEditorOrAbove()
        && (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'adminNote', 'verifiedBy', 'verifiedAt', 'rejectedBy', 'rejectedAt', 'updatedAt']));
      allow delete: if isEditorOrAbove();
    }

    // Legacy order documents contain internal notes and payment/customer data.
    // A bearer URL is not authentication. Keep all records private until a
    // sanitized client view and verified ownership flow are available.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create, update, delete: if isEditorOrAbove();
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }

    // ─── Portfolio / Delivered Works Showcase ────────────────────────────────
    // Admin creates portfolio records from delivered work samples.
    // Public read for showcase display.
    match /portfolio_delivered/{id} {
      allow read: if isAdmin();
      allow write: if isEditorOrAbove();
    }

    // ─── Activity Log / Audit Trail ──────────────────────────────────────────
    // Any admin can write an entry (recording their own actions). Entries are
    // immutable — no update or delete — and only owners can view the trail.
    match /activity_log/{id} {
      allow create: if isAdmin()
        && request.resource.data.actorEmail == request.auth.token.email;
      allow read: if isOwner();
      allow update, delete: if false;
    }

    // ─── Fallback: deny everything else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
