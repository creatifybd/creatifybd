{
  "name": "creatifybd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.js && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "sync:firebase": "node scripts/content-release.mjs sync",
    "content:validate": "node scripts/content-release.mjs validate",
    "content:prepare": "node scripts/content-release.mjs prepare",
    "content:plan": "node scripts/content-release.mjs plan",
    "content:export": "node scripts/content-release.mjs export-draft",
    "test:rules": "firebase emulators:exec --project demo-creatifybd --only firestore,storage --config firebase.emulators.json \"node --test tests/rules.test.mjs\""
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "dompurify": "^3.4.11",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.5",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.29.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "sharp": "^0.35.4",
    "terser": "^5.48.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.5"
  }
}
